APP_ENV=development
LOG_LEVEL=INFO
FRONTEND_ORIGIN=http://localhost:3000
DEEPSEEK_MODEL=deepseek-flash
PROVIDER_TIMEOUT_SECONDS=60
MAX_CONCURRENT_REQUESTS=20
# No server-owned API key is required. Users provide a key in the browser.
# Generate a persistent local encryption key with: uv run python scripts/init_local.py
CREDENTIAL_ENCRYPTION_KEY=
DATABASE_URL=sqlite+aiosqlite:///./thryv.db
SESSION_LIFETIME_SECONDS=604800
AUTH_ATTEMPTS_PER_MINUTE=20

# Optional local speech; install the voice extra and run scripts/setup_voice.py first.
STT_MODEL_PATH=.models/whisper-base.en
WAKE_MODEL_PATH=.models/thryv-wake
TTS_MODEL_PATH=.models/en_US-lessac-medium.onnx
